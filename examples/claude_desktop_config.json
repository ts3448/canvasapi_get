  "mcpServers": {
    "canvas-api": {
      "command": "uv",
      "args": [
        "--directory",
        "/absolute/path/to/canvasapi_get",
        "run",
        "canvasapi-mcp"
      ],
      "env": {
        "CANVAS_URL": "https://myschool.instructure.com",
        "CANVAS_TOKEN": "1234~abcdefghijklmnopqrstuvwxyz1234567890abcd"
      }
    }
  }
}