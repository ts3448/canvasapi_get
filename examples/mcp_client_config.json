{
  "mcpServers": {
    "canvas-api": {
      "command": "uv",
      "args": [
        "--directory",
        "/absolute/path/to/canvasapi_get",
        "run",
        "canvasapi-mcp"
      ],
      "env": {
        "CANVAS_URL": "https://your-school.instructure.com",
        "CANVAS_TOKEN": "your-api-token-here"
      }
    }
  }
}